{
  "name": "ekaynac-profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:profile": "tsx scripts/generate-master-profile.ts",
    "generate:cv": "tsx scripts/generate-cv.ts",
    "generate:readme": "tsx scripts/generate-readme.ts",
    "generate:site": "tsx scripts/generate-site-data.ts",
    "build:cv": "npm run generate:cv && mkdir -p public && tectonic cv/resume.tex --outdir public && mv -f public/resume.pdf public/cv.pdf",
    "lint:ats": "tsx scripts/ats-lint.ts public/cv.pdf",
    "generate:cv:private": "tsx scripts/generate-cv.ts --private",
    "build:cv:private": "npm run generate:cv:private && tectonic cv/private.resume.tex --outdir . && mv -f private.resume.pdf private.cv.pdf",
    "lint:ats:private": "tsx scripts/ats-lint.ts --private"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
